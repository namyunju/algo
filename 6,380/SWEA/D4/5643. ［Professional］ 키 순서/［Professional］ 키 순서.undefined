'''
1번부터 N번 학생 
자신의 키가 몇 번째인지 알 수 있는 학생의 수

자신의 키 번째수를 알기 위해서는 
본인보다 키가 작은 사람 수 + 본인보다 키가 큰 사람 수 가 N-1이어야 함.

'''
T = int(input())

for tc in range(1, T + 1):
    # 학생 수 
    N = int(input())
    # 비교 수
    M = int(input())
    
    # graph[i][j] 로 i가 j 보다 작은지 여부를 표현
    graph = [[False] * (N + 1) for _ in range(N + 1)]

    for _ in range(M):
        a, b = map(int, input().split())
        graph[a][b] = True

    for k in range(1, N + 1):
        for i in range(1, N + 1):
            # i가 k보다 작을 때
            if graph[i][k]:
                for j in range(1, N + 1):
                    # k가 j 보다 작다면
                    if graph[k][j]:
                        # i는 j보다 작음
                        graph[i][j] = True

    answer = 0

    for i in range(1, N + 1):
        count = 0

        for j in range(1, N + 1):
            if i == j:
                continue

            if graph[i][j] or graph[j][i]:
                count += 1

        if count == N - 1:
            answer += 1

    print(f"#{tc} {answer}")