/*
이진트리

두 정점의 공통 조상을 찾아 서브트리의 크기를 출력

공통 조상을 어떻게 찾지
각 노드의 부모를 찾아 올라가다 공통을 발견
*/
#include <iostream>
#include <vector>
#include <unordered_set>
#include <stack>

using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int T;
    cin >> T;

    for (int tc = 1; tc <= T; ++tc) {
        int V, E, n1, n2;
        cin >> V >> E >> n1 >> n2;

        vector<int> parent(V + 1, 0);
        vector<vector<int>> children(V + 1);

        for (int i = 0; i < E; ++i) {
            int p, c;
            cin >> p >> c;
            parent[c] = p;
            children[p].push_back(c);
        }

        // 모든 조상 노드를 올라가며 set에 저장
        unordered_set<int> ancestors;
        int curr = n1;
        while (curr != 0) {
            ancestors.insert(curr);
            curr = parent[curr];
        }

        // 첫 번째로 겹치는 조상 찾기
        int common_ancestor = n2;
        while (ancestors.find(common_ancestor) == ancestors.end()) {
            common_ancestor = parent[common_ancestor];
        }

        stack<int> st;
        st.push(common_ancestor);
        int subtree_size = 0;

        while (!st.empty()) {
            int node = st.top();
            st.pop();
            subtree_size++;

            for (int child : children[node]) {
                st.push(child);
            }
        }

        cout << "#" << tc << " " << common_ancestor << " " << subtree_size << "\n";
    }

    return 0;
}